{
  "version": 1,
  "hooks": {
    "PreToolUse": [
      {
        "type": "command",
        "bash": "agentkit hook copilot",
        "powershell": "agentkit hook copilot",
        "timeoutSec": 120,
        "matcher": "Bash|Edit|Write"
      }
    ],
    "PostToolUse": [
      {
        "type": "command",
        "bash": "agentkit hook copilot",
        "powershell": "agentkit hook copilot",
        "timeoutSec": 120,
        "matcher": "Edit|Write"
      }
    ],
    "Stop": [
      {
        "type": "command",
        "bash": "agentkit hook copilot",
        "powershell": "agentkit hook copilot",
        "timeoutSec": 120
      }
    ]
  }
}
