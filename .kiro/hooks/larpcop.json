{
  "version": "v1",
  "hooks": [
    {
      "name": "larpcop-shell",
      "trigger": "PreToolUse",
      "action": {
        "type": "command",
        "command": "larpcop hook kiro"
      },
      "timeout": 120,
      "matcher": "shell"
    },
    {
      "name": "larpcop-write",
      "trigger": "PreToolUse",
      "action": {
        "type": "command",
        "command": "larpcop hook kiro"
      },
      "timeout": 120,
      "matcher": "write"
    },
    {
      "name": "larpcop-stop",
      "trigger": "Stop",
      "action": {
        "type": "command",
        "command": "larpcop hook kiro"
      },
      "timeout": 120
    }
  ]
}
