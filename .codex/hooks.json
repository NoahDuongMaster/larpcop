{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^(Bash|apply_patch)$",
        "hooks": [
          {
            "type": "command",
            "command": "larpcop hook codex",
            "timeout": 120,
            "statusMessage": "larpcop: checking rules"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^apply_patch$",
        "hooks": [
          {
            "type": "command",
            "command": "larpcop hook codex",
            "timeout": 120,
            "statusMessage": "larpcop: checking rules"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "larpcop hook codex",
            "timeout": 120,
            "statusMessage": "larpcop: checking rules"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "larpcop hook codex",
            "timeout": 120,
            "statusMessage": "larpcop: checking rules"
          }
        ]
      }
    ]
  }
}
