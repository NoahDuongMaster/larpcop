{
  "version": "v1",
  "hooks": [
    {
      "name": "agentkit-shell",
      "trigger": "PreToolUse",
      "action": {
        "type": "command",
        "command": "agentkit hook kiro"
      },
      "timeout": 120,
      "matcher": "shell"
    },
    {
      "name": "agentkit-write",
      "trigger": "PreToolUse",
      "action": {
        "type": "command",
        "command": "agentkit hook kiro"
      },
      "timeout": 120,
      "matcher": "write"
    },
    {
      "name": "agentkit-stop",
      "trigger": "Stop",
      "action": {
        "type": "command",
        "command": "agentkit hook kiro"
      },
      "timeout": 120
    }
  ]
}
