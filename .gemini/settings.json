{
  "hooks": {
    "BeforeTool": [
      {
        "matcher": "^(run_shell_command|write_file|replace)$",
        "hooks": [
          {
            "type": "command",
            "name": "larpcop",
            "command": "larpcop hook gemini",
            "timeout": 120000
          }
        ]
      }
    ],
    "AfterTool": [
      {
        "matcher": "^(run_shell_command|write_file|replace)$",
        "hooks": [
          {
            "type": "command",
            "name": "larpcop",
            "command": "larpcop hook gemini",
            "timeout": 120000
          }
        ]
      }
    ],
    "AfterAgent": [
      {
        "hooks": [
          {
            "type": "command",
            "name": "larpcop",
            "command": "larpcop hook gemini",
            "timeout": 120000
          }
        ]
      }
    ]
  },
  "context": {
    "fileName": [
      "AGENTS.md",
      "GEMINI.md"
    ]
  },
  "mcpServers": {
    "larpcop": {
      "command": "larpcop",
      "args": [
        "mcp"
      ]
    }
  }
}
